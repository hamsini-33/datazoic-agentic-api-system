# ==============================================================================
# Environment Configuration Template
# Copy this file to .env and configure your variables.
# ==============================================================================

# LLM Provider Configuration: 'mock' is the safe offline default.
# Choose 'openai' or 'gemini' only after configuring your own provider credentials.
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini

# API Keys (leave blank if using 'mock' provider for automated offline tests)
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Embedding Configuration
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Storage Paths
DATABASE_PATH=data/system.db
CHROMA_PERSIST_DIR=data/chroma
DOCS_DIR=data/docs

# Orchestration & Confidence Settings
TOP_K_TOOLS=4
SIMILARITY_THRESHOLD=0.35
RAG_SIMILARITY_THRESHOLD=0.35
ENABLE_APPROVAL_GATES=true
